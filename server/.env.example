#######################################################################
# Beyond Walls — server environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
#######################################################################

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------
# Matches the bundled docker-compose.yml. Point this at your managed
# PostgreSQL instance in production.
DATABASE_URL="postgresql://beyondwalls:beyondwalls@localhost:5432/beyondwalls?schema=public"

# --- Auth ------------------------------------------------------------
# Generate strong, unique values before going live, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- URLs ------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:5173"
API_BASE_URL="http://localhost:4000"

# --- Uploads ---------------------------------------------------------
# Absolute path is fine too. Defaults to <server>/uploads.
# UPLOAD_DIR="D:/Beyond Walls/server/uploads"
# Where uploaded files are kept.
#   local     the filesystem (the default; fine for development)
#   database  rows in PostgreSQL -- for a host that rebuilds its disk on
#             each deploy, such as Render, where local disk loses every upload
#   s3 / r2 / cloudinary   object storage, with that provider's credentials
# Stored files keep their ordinary /uploads/... URLs whichever is chosen.
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10
# Re-encode every uploaded raster image as WebP. Catalogue images are capped
# at 2400px on the long edge and compressed for the wire; artwork attached to a
# custom order keeps its dimensions and is compressed gently, because the piece
# is made from it. PDFs pass through untouched.
OPTIMIZE_UPLOADS=true

#######################################################################
# Razorpay
#
# SECURITY: RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are used on
# the server only. They are never sent to the browser and are rejected
# if anyone tries to set them through the admin panel. Only the public
# RAZORPAY_KEY_ID reaches the frontend, which is what Razorpay Checkout
# requires.
#
# Get your keys: Razorpay Dashboard → Settings → API Keys
# Webhook: Razorpay Dashboard → Settings → Webhooks
#   URL     https://your-domain.com/api/webhooks/razorpay
#   Events  payment.authorized, payment.captured, payment.failed,
#           refund.created, refund.processed
#######################################################################
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY=INR

#######################################################################
# Transactional email (SMTP)
#
# Order confirmations, order status updates, password resets, enquiry
# notifications and their acknowledgements all go out over this.
#
# Leaving SMTP_HOST or SMTP_USER blank is a supported state, not a
# broken one: every message is written to the log instead of being sent
# and the request that triggered it still succeeds, so a checkout can
# never fail because mail is down.
#
# Beyond Walls mail is served from the studio's own mail host, so there
# is no third-party provider and no API key -- these are the mailbox's
# own credentials. Port 465 is implicit TLS and the server switches to
# it automatically; 587 is STARTTLS.
#
# SMTP_PASSWORD is the mailbox password. It belongs in .env on the
# server and nowhere else -- it never reaches the browser, and it is
# rejected if anyone tries to set it through the admin panel.
#######################################################################
SMTP_HOST="srv1.zerodimensions.in"
SMTP_PORT=465
SMTP_USER="info@thebeyondwalls.com"
SMTP_PASSWORD=""
# The From header customers see. The mail host must allow SMTP_USER to
# send as this address, or it will refuse the message.
SMTP_FROM="Beyond Walls <info@thebeyondwalls.com>"
# Where enquiries and custom-order requests are announced. Blank falls
# back to the contact email set in the admin panel, which is usually
# what you want -- change one address and both follow.
ADMIN_NOTIFICATION_EMAIL=""

#######################################################################
# Courier (Shiprocket)
#
# Leaving SHIPROCKET_EMAIL or SHIPROCKET_PASSWORD blank disables booking.
# Everything else still works: the studio books in Shiprocket's own panel
# and types the waybill into the order, and the customer gets the same
# tracking email either way.
#
# These are an API user's credentials, not the account login:
#   Shiprocket -> Settings -> API Users -> Add New API User
# It needs the Orders, Shipments and Courier modules, and nothing else.
#
# SHIPROCKET_BASE_URL points at the sandbox while testing. The sandbox
# has its OWN credentials, so the URL and the login change together --
# which is why this is a URL rather than a true/false flag.
#   live      https://apiv2.shiprocket.in
#   sandbox   https://apiv2-sandbox.shiprocket.in
#######################################################################
SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# The pickup location's nickname, spelled exactly as Shiprocket shows it
# under Settings -> Pickup Addresses. A mismatch is rejected at booking.
SHIPROCKET_PICKUP_LOCATION="work"
# Where parcels leave from, for rate and serviceability checks.
SHIPROCKET_PICKUP_PINCODE="380001"
# The shared secret on tracking callbacks, sent by Shiprocket as
# x-api-key. Set the same string in Shiprocket -> Settings -> Webhooks.
# Without it the callback is refused: the URL is not a secret, and anyone
# who learned it could otherwise mark an order delivered.
#
# Note their rule -- a webhook URL may not contain "shiprocket",
# "kartrocket", "sr" or "kr" -- which is why the route is called
# /api/webhooks/parcel-tracking.
SHIPROCKET_WEBHOOK_TOKEN=""

# Fallbacks for a product with no weight or size recorded yet. Couriers
# bill on what is declared, so a default that is too low becomes an
# invoice correction later -- these keep a booking working, they are not
# a substitute for measuring the pieces.
SHIPMENT_DEFAULT_WEIGHT_KG=0.5
SHIPMENT_DEFAULT_LENGTH_CM=25
SHIPMENT_DEFAULT_BREADTH_CM=20
SHIPMENT_DEFAULT_HEIGHT_CM=5

# --- First admin account (used by `npm run seed`) --------------------
SEED_ADMIN_EMAIL="admin@beyondwall.in"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Beyond Walls Admin"

# --- Rate limiting ---------------------------------------------------
# Requests per IP per window across the whole API. The end-to-end suite runs
# two browser projects over the same address and will exceed 600 part-way
# through, at which point pages start rendering their empty states -- raise it
# locally when running the suite.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
# Sign-in and registration attempts per IP per window. Raise it if your
# customers share an address (an office, a campus, a carrier NAT), and while
# running the end-to-end suite locally -- it signs in once per test and will
# otherwise lock itself out part-way through the run.
AUTH_RATE_LIMIT_MAX=30

# Set to true when running behind a reverse proxy (nginx, Render, Railway…)
TRUST_PROXY=false
