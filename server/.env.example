#######################################################################
# Beyond Walls — server environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
#######################################################################

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------
# Matches the bundled docker-compose.yml. Point this at your managed
# PostgreSQL instance in production.
DATABASE_URL="postgresql://beyondwalls:beyondwalls@localhost:5432/beyondwalls?schema=public"

# --- Auth ------------------------------------------------------------
# Generate strong, unique values before going live, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- URLs ------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:5173"
API_BASE_URL="http://localhost:4000"

# --- Uploads ---------------------------------------------------------
# Absolute path is fine too. Defaults to <server>/uploads.
# UPLOAD_DIR="D:/Beyond Walls/server/uploads"
MAX_UPLOAD_MB=10

#######################################################################
# Razorpay
#
# SECURITY: RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are used on
# the server only. They are never sent to the browser and are rejected
# if anyone tries to set them through the admin panel. Only the public
# RAZORPAY_KEY_ID reaches the frontend, which is what Razorpay Checkout
# requires.
#
# Get your keys: Razorpay Dashboard → Settings → API Keys
# Webhook: Razorpay Dashboard → Settings → Webhooks
#   URL     https://your-domain.com/api/webhooks/razorpay
#   Events  payment.authorized, payment.captured, payment.failed,
#           refund.created, refund.processed
#######################################################################
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY=INR

# --- First admin account (used by `npm run seed`) --------------------
SEED_ADMIN_EMAIL="admin@beyondwall.in"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Beyond Walls Admin"

# --- Rate limiting ---------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
# Sign-in and registration attempts per IP per window. Raise it if your
# customers share an address (an office, a campus, a carrier NAT).
AUTH_RATE_LIMIT_MAX=30

# Set to true when running behind a reverse proxy (nginx, Render, Railway…)
TRUST_PROXY=false
