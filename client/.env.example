# Beyond Walls — client environment
#
# These are compiled INTO the JavaScript bundle at build time. Never put a
# secret here: anything in this file is readable by anyone who opens the site.
#
# In production you normally need NONE of them. The server hosts the site and
# the API on one origin, so the build defaults to relative paths and works on
# any domain without being rebuilt.
#
# Set them only when the client is served from a different origin than the API,
# which is the case in local development: Vite on 5173, API on 4000.

# Base URL of the API. Leave unset in production (defaults to /api).
VITE_API_URL="http://localhost:4000/api"

# Where uploaded images are served from. Leave unset in production.
VITE_ASSET_URL="http://localhost:4000"

# Canonical public site URL for SEO tags and JSON-LD. Leave unset to use
# whatever origin the page was loaded from; the admin's SEO settings override
# it anyway.
VITE_SITE_URL="http://localhost:5173"

# NOTE: no Razorpay key here on purpose.
# The public key id is fetched from the API at checkout time
# (GET /api/checkout/config) so it can be rotated without a rebuild,
# and the secret key never leaves the server.
